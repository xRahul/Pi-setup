{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Asia/Kolkata",
  "schedule": ["* 0-5 * * 1"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Major image bumps wait for approval on the Dependency Dashboard",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Postgres majors need a dump/restore; do by hand",
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Immich pins its Postgres image; follow Immich release notes instead",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    { "matchPackageNames": ["/^ghcr\\.io/immich-app//"], "groupName": "immich" },
    { "matchPackageNames": ["/^n8nio//"], "groupName": "n8n" },
    { "matchPackageNames": ["/^fireflyiii//"], "groupName": "firefly" },
    { "matchPackageNames": ["/^ghcr\\.io/we-promise/sure/"], "groupName": "sure" },
    { "matchPackageNames": ["/^ghcr\\.io/gramps-project//"], "groupName": "gramps" },
    { "matchPackageNames": ["/^caddy$/"], "groupName": "caddy" },
    { "matchPackageNames": ["/valkey/valkey$/"], "groupName": "valkey" },
    {
      "description": "linuxserver tags look like 4.1.3-r0-ls362",
      "matchPackageNames": ["/^lscr\\.io/linuxserver//"],
      "matchCurrentValue": "/-ls\\d+$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-r(?<build>\\d+))?-ls(?<revision>\\d+)$"
    }
  ]
}
