[Unit]
Description=Optimize UDP GRO Forwarding for Tailscale WireGuard Throughput
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ethtool -K eth0 rx-udp-gro-forwarding on rx-gro-list off || true
ExecStart=/sbin/ethtool -K wlan0 rx-udp-gro-forwarding on rx-gro-list off || true

[Install]
WantedBy=multi-user.target
